# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.

# ─── GitHub Auth ─────────────────────────────────────────────────────────────

# A GitHub personal access token (PAT) authorized for the open-austin org.
#
# Required scopes:
#   - repo          (read/write issues, labels, milestones, metadata)
#   - project       (read/write Projects v2 boards)
#
# Create at: https://github.com/settings/tokens
#
# If the open-austin org enforces SAML SSO, you must also authorize this token
# for the org at: https://github.com/settings/tokens → "Configure SSO"
#
# This value is also used by the `gh` CLI when set as GH_TOKEN.
GH_TOKEN=ghp_your_token_here

# ─── Target Org ───────────────────────────────────────────────────────────────

# The GitHub org this tooling manages.
GITHUB_ORG=open-austin

# ─── Google Docs through Agent Hands ──────────────────────────────────────────

# Optional shared-Doc operations use the installed Agent Hands Google skills.
# Select the account and document for the actual operation; credentials stay with the provider.
# The retired weekly-meeting skill supplies no document configuration.
AGENT_HANDS_ROOT=/absolute/path/to/agent-hands
OPEN_AUSTIN_GOOGLE_ALIAS=example

# ─── Slack ───────────────────────────────────────────────────────────────────

# Slack Incoming Webhook URLs for posting automated reports.
# Create at: https://api.slack.com/apps → your app → Incoming Webhooks
# Each channel needs its own webhook URL.
#
# Used by: tools/notify/ and GitHub Actions scheduled reports
# Verify current channel ownership before selecting a destination for manual posting.
SLACK_WEBHOOK_ENGAGEMENT=https://hooks.slack.com/services/your/webhook/url
SLACK_WEBHOOK_ORG=https://hooks.slack.com/services/your/webhook/url

# Per-team channels for the weekly summary breakout (2026-07-07). These
# webhooks don't exist yet — create each one in Slack, then fill in the URL.
SLACK_WEBHOOK_BOARD=https://hooks.slack.com/services/your/webhook/url
SLACK_WEBHOOK_INFRASTRUCTURE=https://hooks.slack.com/services/your/webhook/url
SLACK_WEBHOOK_FINANCE=https://hooks.slack.com/services/your/webhook/url
SLACK_WEBHOOK_FUNDRAISING=https://hooks.slack.com/services/your/webhook/url
SLACK_WEBHOOK_COMMUNICATIONS=https://hooks.slack.com/services/your/webhook/url
SLACK_WEBHOOK_EDUCATION=https://hooks.slack.com/services/your/webhook/url
SLACK_WEBHOOK_FELLOWSHIP=https://hooks.slack.com/services/your/webhook/url

# ─── Airtable Auth ───────────────────────────────────────────────────────────

# An Airtable Personal Access Token (PAT) for OA's Airtable, used by tools/airtable/.
#
# Create at: https://airtable.com/create/tokens
# Create it while logged in as your own personal OA account (not the shared
# admin@ owner) so edits are attributed to you as an individual, not a shared
# login. admin@ stays the workspace owner; your account is invited as an editor.
#
# Recommended scopes:
#   - data.records:read
#   - data.records:write
#   - schema.bases:read
#   - schema.bases:write
#   - webhook:manage   (only if webhooks are needed)
# Grant the token access to the specific OA workspaces/bases it should touch.
#
# NEVER commit this token. This repo is public. Never commit Airtable data either.
AIRTABLE_TOKEN=pat_your_token_here
